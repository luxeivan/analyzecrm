# --- Bitrix24 ---
# Входящий вебхук с правами crm. Пример: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=

# --- PostgreSQL ---
POSTGRES_DB=bitrix
POSTGRES_USER=bitrix
POSTGRES_PASSWORD=bitrix
POSTGRES_PORT=5432

# --- Порты хоста ---
API_PORT=4000
WEB_PORT=5173
ADMINER_PORT=8080

TZ=Europe/Moscow

# --- ETL ---
ETL_PAGE_SIZE=50
ETL_SLEEP_MS=1500
ETL_MAX_RETRIES=5
ETL_REQUEST_TIMEOUT_MS=55000
# Поле компании, которое считается "регионом" (если есть свой UF). Пусто = ADDRESS_CITY/PROVINCE
REGION_FIELD=

# --- LLM (опционально) ---
# Вариант 1: polza.ai (OpenAI-совместимый шлюз, много моделей)
POLZA_TOKEN=
POLZA_MODEL=deepseek/deepseek-v4.1-flash-1017
# Вариант 2: любой OpenAI-совместимый API (OpenAI, OpenRouter, Ollama/vLLM)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Векторизация (pgvector) ---
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BATCH=32
# EMBEDDING_LIMIT=1000
# EMBEDDING_INDEX=1

# --- Регулярная синхронизация (внутри API) ---
SYNC_SCHEDULER=0
SYNC_INTERVAL_MIN=15
ETL_MODIFIED_OVERLAP_MIN=5
RECONCILE_DAYS=7

ETL_AUTO_RETRY=10
ETL_AUTO_RETRY_DELAY_MIN=3

# --- Авторизация и роли ---
# Пустой AUTH_ADMIN_PASSWORD => авторизация выключена (локальный доступ без логина)
AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_H=24
